# Copy to .env and fill in real values. Never commit the real .env — it's
# already gitignored. See CONTRIBUTION.md for where to get each value.

# --- Frontend (Vite) ---
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Yoco (StudX Pro subscription checkout)
VITE_YOCO_ENABLED=

# Google AdSense — enable only once the Sites status is "Ready"
VITE_ADSENSE_ENABLED=
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_FEED=

APP_URL=

# --- Cloud Functions secrets ---
# These are NOT env vars — never put them in .env or Vite. Set them via:
#   firebase functions:secrets:set YOCO_SECRET_KEY
#   firebase functions:secrets:set YOCO_WEBHOOK_SECRET
# functions/.env.stud-x mirrors APP_URL / CLOUDINARY_CLOUD_NAME for the
# functions runtime — keep both in sync manually, they are not shared.
