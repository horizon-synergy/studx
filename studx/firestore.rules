rules_version = '2';

// StudX Firestore security rules
//
// These rules mirror exactly how src/services/firebase.js reads and writes.
// Deploy with:  firebase deploy --only firestore:rules
//
// NOTE: `orderBy(createdAt/lastMessageAt)` queries require the composite
// indexes defined in firestore.indexes.json (deployed separately).

service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────────────────────────────────────
    // Helpers
    // ────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isListingSeller(listingId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/listings/$(listingId)).data.sellerId == request.auth.uid;
    }

    function isOrderParticipant(orderId) {
      if (!isSignedIn()) return false;
      let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return request.auth.uid == order.buyerId || request.auth.uid == order.sellerId;
    }

    function isChatParticipant(chatId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    // ────────────────────────────────────────────────
    // USERS — public read (public profiles / admin list), owner writes, admin updates
    // ────────────────────────────────────────────────
    match /users/{uid} {
      allow read:  if true;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ────────────────────────────────────────────────
    // PROFILES — public read, owner writes
    // ────────────────────────────────────────────────
    match /profiles/{uid} {
      allow read:  if true;
      allow write: if isOwner(uid);
    }

    // ────────────────────────────────────────────────
    // LISTINGS — public read, seller manages own, admin features
    // ────────────────────────────────────────────────
    match /listings/{listingId} {
      allow read:  if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || isListingSeller(listingId);
      allow delete: if isAdmin() || isListingSeller(listingId);
    }

    // ────────────────────────────────────────────────
    // ORDERS — buyer/seller manage own lifecycle, admin manages all
    // ────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read:   if isAdmin() || isOrderParticipant(orderId);
      allow create: if isSignedIn();
      allow update: if isAdmin() || isOrderParticipant(orderId);
      allow delete: if false;
    }

    // ────────────────────────────────────────────────
    // NOTIFICATIONS — owner reads/updates; signed-in users may create
    // (client pushes notifications to the recipient's inbox)
    // ────────────────────────────────────────────────
    match /notifications/{id} {
      allow read:   if isOwner(resource.data.uid);
      allow create: if isSignedIn();
      allow update: if isOwner(resource.data.uid);
      allow delete: if isOwner(resource.data.uid);
    }

    // ────────────────────────────────────────────────
    // COUPONS — public read (code validation), seller manages own, admin manages all
    // ────────────────────────────────────────────────
    match /coupons/{id} {
      allow read:   if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || resource.data.sellerId == request.auth.uid;
      allow delete: if isAdmin() || resource.data.sellerId == request.auth.uid;
    }

    // ────────────────────────────────────────────────
    // REVIEWS & COMMENTS — public read, authors write, listing seller may delete
    // ────────────────────────────────────────────────
    match /reviews/{id} {
      allow read:   if true;
      allow create: if isSignedIn();
      allow update: if isOwner(resource.data.authorId);
      allow delete: if isOwner(resource.data.authorId) || isListingSeller(resource.data.listingId);
    }

    match /comments/{id} {
      allow read:   if true;
      allow create: if isSignedIn();
      allow update: if isOwner(resource.data.authorId);
      allow delete: if isOwner(resource.data.authorId) || isListingSeller(resource.data.listingId);
    }

    // ────────────────────────────────────────────────
    // WISHLISTS — owner only
    // ────────────────────────────────────────────────
    match /wishlists/{uid} {
      allow read:  if isOwner(uid);
      allow write: if isOwner(uid);
    }

    // ────────────────────────────────────────────────
    // CHECKOUTS — buyer owns, admin manages all
    // ────────────────────────────────────────────────
    match /checkouts/{id} {
      allow read:   if isAdmin() || isOwner(resource.data.buyerId);
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ────────────────────────────────────────────────
    // CHATS — participants only (docs + nested messages subcollection)
    // ────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read:   if isAdmin() || request.auth.uid in resource.data.participants;
      allow create: if isSignedIn();
      allow update: if isAdmin() || request.auth.uid in resource.data.participants;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read:   if isAdmin() || isChatParticipant(chatId);
        allow create: if isAdmin() || isChatParticipant(chatId);
        allow update: if false;
        allow delete: if false;
      }
    }

    // ────────────────────────────────────────────────
    // SETTINGS — signed-in users may read (chat TTL), admin writes
    // ────────────────────────────────────────────────
    match /settings/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
